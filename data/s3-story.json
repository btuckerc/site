          "area",
          "and",
          "the",
          "collision",
          "boundary",
          "have",
          "to",
          "agree,",
          "or",
          "the",
          "fleck",
          "can",
          "slide",
          "right",
          "into",
          "a",
          "clipped",
          "corner",
          "and",
          "vanish."
