          "the",
          "game",
          "settles,",
          "it",
          "compares",
          "the",
          "party",
          "and",
          "storage",
          "boxes",
          "with",
          "the",
          "earlier",
          "state.",
          "It",
          "looks",
          "for",
          "a",
          "Pokémon",
          "identity",
          "that",
          "was",
          "absent",
          "before",
          "and",
          "appears",
          "exactly",
          "once",
          "afterward."
