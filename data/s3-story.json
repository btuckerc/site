      "paragraphs": [
        [
          "Asking",
          "'Who's",
          "in",
          "my",
          "party?'",
          "is",
          "a",
          "different",
          "kind",
          "of",
          "request",
          "from",
          "'Win",
          "this",
          "battle.'",
          "To",
          "answer",
          "a",
          "question,",
          "the",
          "app",
          "just",
          "reads",
          "the",
          "current",
          "party",
          "state",
          "without",
          "sending",
          "any",
          "movement",
          "or",
          "battle",
          "inputs."
