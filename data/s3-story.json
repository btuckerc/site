      "paragraphs": [
        [
          "Grain",
          "is",
          "a",
          "tiny",
          "motion",
          "game",
          "on",
          "the",
          "same",
          "handheld.",
          "You",
          "tilt",
          "the",
          "device",
          "to",
          "steer",
          "a",
          "little",
          "fleck",
          "around",
          "a",
          "rounded",
          "play",
          "area.",
