      "paragraphs": [
        [
          "Before",
          "the",
          "controller",
          "reports",
          "a",
          "catch,",
          "it",
          "has",
          "to",
          "show",
          "up",
          "in",
          "the",
          "actual",
          "game",
          "state.",
          "Once",
          "the",
          "game",
          "settles,",
          "it",
          "diffs",
          "your",
          "party",
          "and",
          "PC",
          "storage",
          "boxes",
          "against",
          "how",
          "they",
          "looked",
          "before,",
          "looking",
          "for",
          "one",
          "new",
          "Pokémon",
          "that",
          "wasn't",
          "there",
          "earlier."
        ],
        [
          "Just",
          "checking",
          "the",
          "species",
          "name",
          "wouldn't",
          "cut",
          "it.",
          "If",
          "you",
          "already",
          "had",
          "a",
          "Zigzagoon",
          "sitting",
          "in",
          "storage,",
          "seeing",
          "a",
          "Zigzagoon",
          "afterward",
          "wouldn't",
          "prove",
          "this",
          "attempt",
          "was",
          "the",
          "one",
          "that",
          "caught",
          "it."
        ]
