          "the",
          "fleck",
          "is",
          "only",
          "seven",
          "pixels",
          "wide,",
          "tiny",
          "tweaks",
          "to",
          "how",
          "it",
          "moves",
          "make",
          "a",
          "big",
          "difference",
          "in",
          "how",
          "it",
          "feels."
        ],
        [
          "The",
          "motion",
          "simulation",
          "ticks",
          "at",
          "240",
          "Hz",
          "under",
          "the",
          "hood.",
          "That's",
          "the",
          "internal",
          "physics",
          "rate,",
          "separate",
          "from",
          "how",
          "fast",
          "the",
          "screen",
          "refreshes."
        ]
      ]
    },
    {
      "id": "corners",
      "title": [
